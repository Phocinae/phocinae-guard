# ---- Python bytecode / build caches ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Packaging / build metadata ----
*.egg-info/
*.egg-link
.eggs/
build/
*.egg

# ---- Test & tool caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Runtime / audit state ----
# guard.py writes its JSONL audit log to ./phocinae-guard.audit.jsonl by default
# (see guard.py audit_path). It records every command, cwd and verdict, so it
# must never be committed.
phocinae-guard.audit.jsonl
.phocinae-guard.audit.jsonl
audit.jsonl

# Local (non-example) guard configuration may contain machine-specific paths.
guard.conf.json
phocinae_guard.conf.json

# Runtime state produced by the test suites themselves (a scratch L0 table and an
# audit log). The audit log records every command and verdict, so it must not be
# committed; it was accidentally tracked once and is now ignored.
phocinae-guard-test-table.json
phocinae-guard-test.audit.jsonl

# ---- Release artifacts ----
# NOTE: the wheel/sdist files currently committed under dist/ are intentionally
# shipped release artifacts for this repo (see git history, e.g.
# "release: phocinae-guard 0.1.2 metadata sync (...; dist artifacts 0.1.2)").
# They are therefore NOT ignored. Uncomment the line below only if that policy
# changes.
# dist/

# ---- Editor / OS junk ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# ---- CI build output ----
# The release workflows build with `--outdir dist-upload` so the uploaded artifact is
# exactly what the commit produced (dist/ holds historical releases on purpose). This
# directory is output, not source: a local `python -m build --outdir dist-upload` put a
# 1.2 MB wheel into the index once already.
dist-upload/
