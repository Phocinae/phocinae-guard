{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|pwsh|Shell|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
