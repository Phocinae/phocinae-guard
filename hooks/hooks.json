{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|pwsh|Shell|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run_guard.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_hook.py\" || exit 2",
            "shell": "bash",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
